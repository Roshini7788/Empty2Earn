# Empty2Earn — Environment Variables Configuration

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/empty2earn?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:your_secure_password@cluster0.mongodb.net/empty2earn?retryWrites=true&w=majority

# JWT Secret for Signing Auth Tokens
JWT_SECRET=empty2earn_super_secret_jwt_key_2026

# Optional: Frontend API Base URL (Defaults to '/api' for same-origin Vercel deployment)
# For local development with external server or separate domain, set accordingly:
VITE_API_BASE_URL=/api
